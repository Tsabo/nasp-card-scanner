{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run in browser",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "running at (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Debug in Edge",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "running at (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}"
      }
    }
  ]
}
